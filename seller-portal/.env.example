# Seller Service Portal — environment (copy to .env; .env is gitignored)
PORT=4000
# Dedicated least-privilege DB user on the SAME Cloud SQL instance as Knite.
DATABASE_URL=postgresql://ssp:CHANGE_ME@34.100.254.57:5432/knite?sslmode=require
PGSSLMODE=require
# Long random string (independent of Knite).
JWT_SECRET=CHANGE_ME
# Set true only once the portal is behind HTTPS (a domain + Caddy TLS).
SSP_COOKIE_SECURE=false
# Where safety-claim images are stored inside the container (bind-mounted to host).
SSP_DATA_DIR=/app/data
SSP_SAFETY_RETENTION_DAYS=60
